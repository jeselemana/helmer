PORT=5050
NODE_ENV=development
APP_URL=https://helmeros.com
ALLOWED_ORIGINS=https://helmeros.com,https://www.helmeros.com
TRUSTED_ORIGINS=https://helmeros.com,https://www.helmeros.com
ADMIN_USER_IDS=
ADMIN_USERNAMES=
OPENAI_API_KEY=
DEEP_RESEARCH_ENABLED=false
MAX_CLARIFICATION_ROUNDS=2

# Google OAuth 2.0 (Google Sign-In) Client ID
GOOGLE_CLIENT_ID=471975374819-mgn2g8auc7q9eko71air922aoo7h963p.apps.googleusercontent.com

# Legacy settings for Deep Research only. Leave unset while the feature is frozen.
GEMINI_API_KEY=
GEMINI_USE_VERTEX=
GEMINI_MAX_OUTPUT_TOKENS=65536
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_CLOUD_REGION=us-central1
# CLOUD_RUN_SERVICE_ACCOUNT=helmer-runtime@YOUR_PROJECT_ID.iam.gserviceaccount.com

ENABLE_BUILD_SEARCH_GROUNDING=true

# Required in production: shared sessions, execution locks, guest quotas and AI budgets.
REDIS_URL=
SESSION_SECRET=
AUTH_SECRET=

# Positive integer. Shared owner/IP guest quota; resets at 00:00 UTC (04:00 Asia/Baku).
# Includes the current request: 5 allows five full answers. Rejected pre-provider requests are refunded.
GUEST_AI_DAILY_LIMIT=5
GUEST_BUILD_DAILY_LIMIT=3

# Email verification codes and password reset delivery. Required in production.
RESEND_API_KEY=
EMAIL_FROM=Helmer <no-reply@helmeros.com>
LEGAL_REPORT_EMAIL=

# Security & Bot Defense (Cloudflare Turnstile for signup and guest AI queries)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI Model Pricing & Budgeting (Defaults are built-in; optional overrides in JSON format)
# Build reserves realistic thinking-aware token budgets (16k-32k) before starting Hydrogen/Carbon and settles actual usage.
# AI_MODEL_PRICING={"gemini-4-hydrogen":{"input":1.50,"output":7.50,"search":0.035},"gemini-4-carbon":{"input":2.00,"output":10.00,"search":0.014},"gpt-5.6-luna":{"input":0.25,"output":1.00,"search":0.030}}
AI_USER_DAILY_USD=5
AI_PLATFORM_DAILY_USD=100
ASK_MAX_CONCURRENT=100
AI_MAX_PROVIDER_SLOTS=32

# SMTP is an alternative to Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 persistent storage. Required unless a Render persistent disk is attached.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# AI Learning Loop v1. Prices are USD per 1M tokens. Leave unset/0 rather than
# guessing: affected interactions keep estimatedCost=null and are marked unpriced.
AI_LEARNING_CANDIDATE_THRESHOLD=0.75
AI_QUALITY_BASELINE=0.5
AI_QUALITY_EXPLICIT_POSITIVE=0.5
AI_QUALITY_EXPLICIT_NEGATIVE=-0.65
AI_QUALITY_ACCEPTED=0.3
AI_QUALITY_COPIED=0.12
AI_QUALITY_FINAL_ITERATION=0.22
AI_QUALITY_REGENERATED=-0.25
AI_QUALITY_EDITED=-0.12
AI_QUALITY_CORRECTION=-0.08
OPENAI_LUNA_INPUT_USD_PER_1M=0
OPENAI_LUNA_OUTPUT_USD_PER_1M=0
OPENAI_TERRA_INPUT_USD_PER_1M=0
OPENAI_TERRA_OUTPUT_USD_PER_1M=0
## Set to true only when intentionally enabling the maintenance page.
MAINTENANCE_MODE=false
